[Unit]
Description=LiteLLM fixed-purpose pre-update backup gate
After=snap.docker.dockerd.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I /usr/local/lib/litellm-backup/gate.py
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin HOME=/root DOCKER_CONFIG=/root/.docker
# Snap's Docker CLI must change its AppArmor profile; NoNewPrivileges breaks it.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
